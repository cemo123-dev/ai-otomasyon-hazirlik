{
  "expo": {
    "name": "Skor+",
    "slug": "futbol-canli-skor",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.skorplus.app",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.skorplus.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0A0E14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#0A0E14"
        }
      ]
    ],
    "scheme": "skorplus",
    "backgroundColor": "#0A0E14",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "cb0048a9-a3dd-431f-8571-b72138ffb294"
      }
    },
    "owner": "cemo123",
    "updates": {
      "url": "https://u.expo.dev/cb0048a9-a3dd-431f-8571-b72138ffb294"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
