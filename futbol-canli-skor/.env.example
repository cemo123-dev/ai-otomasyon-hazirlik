# Boş bırakılırsa uygulama önizleme (mock) modunda çalışır.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Supabase bilgileri girilse bile mock veriyi zorlamak için 1 yapın
EXPO_PUBLIC_PREVIEW_MODE=
# F3 paylaşım/davet bağlantıları için indirme sayfası (gizli değil). Boşsa "Paylaş" ve davet kartı gizlenir.
EXPO_PUBLIC_DOWNLOAD_URL=
# Döngü 11 — Play sürümü (gizli değil; EAS ortam değişkeni olarak production ortamına girilir):
# Play mağaza sayfası. Tanımlıysa paylaşım/davet bağlantıları &referrer=utm_source%3Dapp… biçiminde Play'e gider.
EXPO_PUBLIC_PLAY_URL=
# RevenueCat "Public SDK key" (Android, goog_ ile başlar). Boşsa satın alma kapalı, paywall bugünkü gibi.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# RevenueCat yetki (entitlement) kimliği; boşsa "pro"
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=
